# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Username of your bot in BotFather (without @), used in invite links
TELEGRAM_BOT_NAME=

# Damage assessment is hybrid: a free local detector checks every photo,
# unclear cases go to Claude Haiku (~$0.0005 per photo).
# Optional: without it only the local detector (or, with no local model, a rough heuristic) is used.
ANTHROPIC_API_KEY=
# Share of "clean" photos still double-checked by Claude (0..1)
DAMAGE_AUDIT_RATE=0.05
